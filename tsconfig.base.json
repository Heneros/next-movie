{
    "compilerOptions": {
        "target": "es2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": false,
        "sourceMap": false,
        "strictPropertyInitialization": false,
    },
    "exclude": [
        "node_modules",
        "test",
        "dist",
        "ignore"
    ]
}