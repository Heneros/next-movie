

generator client {
  provider = "prisma-client-js"
  // output   = "../../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum Recommended {
  GOOD 
  NEUTRALITY 
  NEGATIVE
}

model VerifyResetToken {
  id        Int   @id @default(autoincrement())
  token     String
  userId    Int   @unique
  user      User  @relation(name: "UserVerifyToken", fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

model Favorites{
  id Int @id @default(autoincrement())

  movie Movie @relation(fields: [movieId], references: [id], onUpdate: Cascade, onDelete: Cascade  )

  movieId Int
  userId Int
    tvShowId Int

  
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade  )

  tvShow TvShow @relation(fields: [tvShowId], references: [id], onUpdate: Cascade, onDelete: Cascade )

  @@unique([userId, movieId, tvShowId])
  @@index([userId])
  @@index([movieId])
  @@index([tvShowId])
}

model User {
  id           Int               @id @default(autoincrement())
  username     String            @unique
  email        String            @unique 
  payment      String?           @default("Bank")
  role         UserRole          @default(USER)

  refreshToken String[]
  token    VerifyResetToken? @relation(name: "UserVerifyToken")



  password     String
  isEmailVerified Boolean? @default(false)

  blocked    Boolean @default(false)


  provider       String?  @default("email")
  providerId     String? 

 
  googleId  String? @unique()
  githubId  String? @unique()
  discordId String? @unique()

  createdAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  visits ProfileVisit[]
  movies          Movie[] 
  likes           Like[]
  comments        Comment[]
  orders          Order[]
  chats           ChatUser[]
  messages        Message[]
  watchList       WatchListItem[] 
  review Review?

  avatar      Avatar[]

  favorites Favorites[]

}

model ProfileVisit {
    id         Int      @id @default(autoincrement())
    userId     Int
    ipHash         String 
    year      Int
    month     Int  



    visitDate DateTime @default(now()) @db.Date
    updatedAt DateTime @updatedAt
  @@unique([userId, ipHash, visitDate])
    @@index([userId, year, month])
     user User @relation(fields: [userId], references: [id], onDelete: Cascade)
   }

model TvShow {
    id            Int       @id @default(autoincrement())
   title     String 
  description   String?
  slug          String    @unique
  year          Int?
  category        String[] 
  tags String[]  
  published Boolean @default(false)
  provider String?
  avgRating     Float @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  backdropUrl String?
  backdropPublicId String?

  posterUrl String? 
  posterUrlId String? 


  galleryImages GalleryImage[]
  favorites Favorites[]
}

model Movie {
  id            Int       @id @default(autoincrement())
   title     String 
  description   String?
  slug          String    @unique
  year          Int?
  category        String[] 
  
  published Boolean @default(false)



  author      User     @relation(fields: [authorId], references: [id], onDelete:  SetNull)

  provider String? 
  tags String[]

  authorId      Int 
  avgRating     Float @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  backdropUrl String?
  backdropPublicId String?

  posterUrl String? 
  posterUrlId String? 

  galleryImages GalleryImage[]
  poster      Avatar[]  
  comments      Comment[]
  likes         Like[]
 

  review Review[]
  watchItem WatchListItem[]
  directors    Director[] @relation("MovieDirectors")
 /// directorId Int[]
  favorites Favorites[]
}


model Director{
    id        Int      @id @default(autoincrement())
  name      String
  bio       String?
  birthDate DateTime?

  movies    Movie[]  @relation("MovieDirectors")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  email     String
  username  String
  message   String
  createdAt DateTime @default(now())
}





model Comment{
  id Int  @id @default(autoincrement())
  userId    Int  
  movieId   Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])
}

model Like{
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId], map: "userId_movieId_unique")
}

model Chat {
  id        Int       @id @default(autoincrement())
  title     String?
  isGroup   Boolean   @default(false)
  createdAt DateTime  @default(now())
  users     ChatUser[]
  messages  Message[]
}

model ChatUser{
   id      Int  @id @default(autoincrement())
  chatId  Int
  userId  Int
  joinedAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])

 @@unique([chatId, userId])
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  userId    Int
  body      String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Order {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String   
  providerId   String?  
  amount       Float
  currency     String   @default("USD")
  status       String   @default("pending") 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}


model WatchListItem {
    id    String @id @default(cuid())
    user User @relation(fields: [userId], references: [id])
    userId Int 
    
    movie Movie @relation(fields: [movieId], references: [id])
    movieId Int 
    createdAt DateTime @default(now())

    @@unique([userId, movieId])
}


model Avatar{
    id       Int    @id @default(autoincrement())
  url      String
  publicId String 

  userId   Int?
  movieId  Int?

  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  movie    Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  // movie    Movie?

  createdAt DateTime @default(now())
}


model GalleryImage{
    id       Int    @id @default(autoincrement())
    url String 
    publicId String 

   tvShow TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
   tvShowId Int 

   movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
   movieId Int 

   createdAt DateTime @default(now())

   @@index([movieId])
      @@index([tvShowId])
}

model Review{
  id Int @id @default(autoincrement())

  movie Movie  @relation(fields: [movieId], references: [id],  onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id],  onDelete: Cascade)


  userId Int @unique
  movieId  Int

  text      String     
  feedback  Recommended 


  createdAt DateTime @default(now())
  updatedAt      DateTime  @updatedAt
}