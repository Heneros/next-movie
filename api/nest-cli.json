{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": ".src/",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [
          ".ts",
          ".tsx",
          ".js",
          ".jsx"
        ]
      }
    },
    "assets": [
      {
        "include": "mail/templates/**/*.hbs",
        "watchAssets": true,
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}